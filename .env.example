# CockroachDB Cloud (Basic tier is sufficient -- verified with infra/preflight.py;
# every capability this project needs, including the vector index, runs on the
# free tier. Upgrade to Standard only if preflight reports a hard failure.)
# From: ccloud cluster sql <cluster> --connection-string
BMEM_DATABASE_URL=postgresql://user:pass@host:26257/branchable?sslmode=verify-full

# AWS
AWS_REGION=us-east-1
BMEM_S3_BUCKET=branchable-memory-artifacts
BMEM_CODEBUILD_PROJECT=branchable-memory-eval

# Bedrock model IDs. Sonnet 4.6 carries the "us." Geo-inference prefix --
# verified against AWS's own model card that us-east-1 has NO in-region option
# for this model, only cross-region ("Geo"/"Global") profiles; the bare id
# (anthropic.claude-sonnet-4-6, no prefix) fails on-demand invocation outright.
# "us." keeps every request inside the US (us-east-1/us-east-2/us-west-2);
# "global." would route anywhere worldwide. Titan needs no such prefix -- it's
# a first-party Amazon model with direct on-demand support.
#
# Sonnet 4.6, not Sonnet 5 or Opus 4.8. Sonnet 5 and Opus 4.8 are cheaper/more
# capable respectively, but AWS blocks brand-new/low-usage accounts from the
# whole newest model generation (Fable 5, Sonnet 5, Opus 4.7, Opus 4.8) with an
# HTTP 403 until the account matures or a Support case clears it -- a documented
# platform restriction, not something to fix in this codebase. Sonnet 4.6 is
# not caught by that gate. $3/$15 per MTok.
#
# Also note: Anthropic models on Bedrock (unlike Amazon's own, e.g. Titan)
# require a one-time "First-Time-Use" form, completed by sending one prompt to
# the model in the Bedrock console's Chat/Text playground. This is separate
# from -- and checked before -- the on-demand-invocation requirement above;
# expect "ValidationException: Operation not allowed" from the CLI/API until
# it's done, regardless of which model id you pass.
#
# This account has a $100 promotional credit -- one shared balance every
# billable service here (Bedrock, CodeBuild build-minutes, S3, the Elastic
# Beanstalk EC2 instance) draws against, not per-service free-tier hours.
# Realistic draw for this project: ingesting 1,512 chunks is a few cents of
# embedding; a full four-branch migration is a handful of short reasoning
# calls plus a few CodeBuild build-minutes, well under $1 per run; a t3.micro
# EB environment left running is roughly $7.50/month if it is not separately
# free-tier eligible. Iterating through development and recording the demo
# comfortably fits inside $20-30, leaving real margin in the $100.
BMEM_REASONING_MODEL=us.anthropic.claude-sonnet-4-6
BMEM_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BMEM_EMBEDDING_DIMS=1024

# Reasoning provider for plan.py/explore.py. Leave unset for "bedrock".
#
# Bedrock is the intended backend and the default, because this is an AWS
# hackathon and "Bedrock generates the competing hypotheses" is the AWS story.
# The alternatives exist because Bedrock *model access* and Bedrock *quota*
# are separate approvals: this account has access granted and every relevant
# quota still sitting at 0, which surfaces as ThrottlingException rather than
# AccessDenied. See bmem.readiness, which reports that distinction.
#
# Whichever provider actually serves a call is recorded per branch in
# execution_manifests (provider + model id), so a decision's provenance can
# never claim Bedrock for a call something else answered. Switching back is
# deleting these lines -- the planner/explorer are selected by factory.
#
#   openai     -- real GPT reasoning; needs OPENAI_API_KEY
#   anthropic  -- real Claude via the direct API; needs ANTHROPIC_API_KEY
#
# Neither is AWS. If Bedrock quota lands before submission, unset these.
# BMEM_REASONING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# BMEM_REASONING_MODEL=gpt-4o
#
# BMEM_REASONING_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Embedding provider, independent of the reasoning provider above. Leave unset
# for "titan" (Bedrock). The OpenAI v3 models support native dimension
# reduction, so 1024 is a genuine 1024-dimension vector and the VECTOR(1024)
# column and index need no migration.
#
# Embeddings from different models are NOT comparable: do not mix providers
# within one branch lineage, or retrieval distances stop meaning anything.
# Re-ingest a repository after switching rather than appending to it.
# BMEM_EMBEDDING_PROVIDER=openai
# BMEM_EMBEDDING_MODEL_OPENAI=text-embedding-3-small

# Shared secret the CockroachDB changefeed presents to the webhook endpoint
BMEM_CHANGEFEED_SECRET=change-me

# Cost guardrail: hard ceiling on tokens a single branch worker may spend
BMEM_BRANCH_TOKEN_BUDGET=200000

# CodeBuild target -- pin to the exact commit you ingested from, not a branch
# name, so every branch in a run (and every run on different days) scores
# candidate patches against an identical baseline.
BMEM_TARGET_REPO=https://github.com/CTFd/CTFd.git
BMEM_TARGET_REF=<commit sha .work/CTFd was cloned at>
# The API layer, matching this project's stated scope (see README). Empty
# runs the full suite (~103 files, real minutes per branch in CodeBuild);
# tests/api (~34 files) is what the live demo actually uses.
BMEM_TEST_SELECTOR=tests/api
