__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

.env
.env.local
*.pem
*.crt

.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Ingested target repo + local artifacts
.work/
